{
  "name": "alarm-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.x || >=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "npm run build && wrangler dev --env-file .env.local --port 5173",
    "build": "npm run check:node && vite build",
    "preview": "npm run dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run check:node && tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251205.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.53.0"
  }
}
