{
  "name": "alarm-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.x || >=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "npm run build && node dist/server.js",
    "build": "npm run check:node && vite build && esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "npm run start",
    "deploy": "npm run build",
    "typecheck": "npm run check:node && tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3"
  }
}
